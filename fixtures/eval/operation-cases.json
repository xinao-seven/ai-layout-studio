{
  "schemaVersion": 1,
  "description": "M2 operation-runner cases. Each case loads a built-in scene, applies semantic patch ops and asserts the server outcome. Add agent/proposal cases as M3/M4 land.",
  "cases": [
    {
      "id": "M2-OP-01-add-plant",
      "tags": [
        "operation",
        "placement",
        "valid"
      ],
      "scene": "fixtures/scenes/studio.json",
      "operations": [
        {
          "op": "item.add",
          "item": {
            "id": "it_eval_plant",
            "kindId": "plant",
            "variantId": "default",
            "transform": {
              "position": [
                0.7,
                0,
                3.3
              ],
              "rotationY": 0
            },
            "source": "manual"
          }
        }
      ],
      "expect": {
        "version": 2,
        "items": [
          {
            "kindId": "plant",
            "count": 2
          }
        ],
        "assert": [
          "noCollision",
          "insideRoom",
          "doorClear"
        ]
      }
    },
