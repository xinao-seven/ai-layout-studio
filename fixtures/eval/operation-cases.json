{
  "schemaVersion": 1,
  "description": "M2 operation-runner cases. Each case loads a built-in scene, applies semantic patch ops and asserts the server outcome. Add agent/proposal cases as M3/M4 land.",
  "cases": [
    {
      "id": "M2-OP-01-add-plant",
      "tags": ["operation", "placement", "valid"],
      "scene": "fixtures/scenes/studio.json",
      "operations": [
        {
          "op": "item.add",
          "item": {
            "id": "it_eval_plant",
            "kindId": "plant",
            "variantId": "default",
            "transform": { "position": [0.7, 0, 3.3], "rotationY": 0 },
            "source": "manual"
          }
        }
      ],
      "expect": {
        "version": 2,
        "items": [{ "kindId": "plant", "count": 2 }],
        "assert": ["noCollision", "insideRoom", "doorClear"]
      }
    },
    {
      "id": "M2-OP-02-collision-refused",
      "tags": ["operation", "placement", "refusal", "collision"],
      "scene": "fixtures/scenes/studio.json",
      "operations": [
        {
          "op": "item.add",
          "item": {
            "id": "it_eval_collision",
            "kindId": "plant",
            "variantId": "default",
            "transform": { "position": [6.2, 0, 4.2], "rotationY": 0 },
            "source": "manual"
          }
        }
      ],
      "expect": { "refusal": "collision" }
    },
    {
      "id": "M2-OP-03-out-of-room-refused",
      "tags": ["operation", "placement", "refusal", "out_of_room"],
      "scene": "fixtures/scenes/studio.json",
      "operations": [
        {
          "op": "item.add",
          "item": {
            "id": "it_eval_outside",
            "kindId": "plant",
            "variantId": "default",
            "transform": { "position": [20, 0, 20], "rotationY": 0 },
            "source": "manual"
          }
        }
      ],
      "expect": { "refusal": "out_of_room" }
    },
    {
      "id": "M2-OP-04-blocks-door-refused",
      "tags": ["operation", "placement", "refusal", "blocks_door"],
      "scene": "fixtures/scenes/studio.json",
      "operations": [
        {
          "op": "item.add",
          "item": {
            "id": "it_eval_door_block",
            "kindId": "plant",
            "variantId": "default",
            "transform": { "position": [0.4, 0, 2.5], "rotationY": 0 },
            "source": "manual"
          }
        }
      ],
      "expect": { "refusal": "blocks_door" }
    },
    {
      "id": "M2-OP-05-add-door",
      "tags": ["operation", "opening", "valid"],
      "scene": "fixtures/scenes/studio.json",
      "operations": [
        {
          "op": "opening.add",
          "opening": {
            "id": "op_eval_bath_door",
            "type": "door",
            "roomId": "room_studio_bath",
            "edgeIndex": 0,
            "offsetFrom": "start",
            "offset": 1.25,
            "width": 0.8,
            "height": 2.1,
            "door": { "swing": "single", "hinge": "start", "opensTo": "in" }
          }
        }
      ],
      "expect": { "version": 2, "assert": ["insideRoom"] }
    },
    {
      "id": "M2-OP-06-opening-overlap-refused",
      "tags": ["operation", "opening", "refusal", "opening_overlap"],
      "scene": "fixtures/scenes/studio.json",
      "operations": [
        {
          "op": "opening.add",
          "opening": {
            "id": "op_eval_overlap",
            "type": "window",
            "roomId": "room_studio_main",
            "edgeIndex": 2,
            "offsetFrom": "start",
            "offset": 4.0,
            "width": 1.0,
            "height": 1.2,
            "sillHeight": 0.9
          }
        }
      ],
      "expect": { "refusal": "opening_overlap" }
    },
    {
      "id": "M2-OP-07-invalid-polygon-refused",
      "tags": ["operation", "room", "refusal", "invalid_polygon"],
      "scene": "fixtures/scenes/studio.json",
      "operations": [
        {
          "op": "room.add",
          "room": {
            "id": "room_eval_bad",
            "name": "Bad room",
            "type": "other",
            "polygon": [[20, 20], [22, 22], [22, 20], [20, 22]]
          }
        }
      ],
      "expect": { "refusal": "invalid_polygon" }
    },
    {
      "id": "M2-OP-08-reanchor-warning",
      "tags": ["operation", "room", "opening", "warning"],
      "scene": "fixtures/scenes/studio.json",
      "operations": [
        {
          "op": "room.update",
          "roomId": "room_studio_bath",
          "after": {
            "polygon": [[8, 0], [10.6, 0], [10.6, 3], [8, 3]]
          }
        }
      ],
      "expect": { "version": 2, "assert": ["insideRoom"] }
    }
  ]
}
