# Environment variables (copy to .env; never commit real keys)

# Server binding. Keep 127.0.0.1 for local-only use. Setting 0.0.0.0 exposes an
# unauthenticated API to your network — only do this on a trusted network.
HOST=127.0.0.1
PORT=8000
DATA_DIR=./data

# LLM (OpenAI-compatible; GLM / Qwen / DeepSeek are fine)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional: replay a JSONL script instead of calling a model (local demos/tests).
# Example: LLM_SCRIPT_PATH=fixtures/llm/G1-01.jsonl
LLM_SCRIPT_PATH=

# VLM (GLM-4V / Qwen-VL). Screenshots leave the machine when enabled; see README.
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=