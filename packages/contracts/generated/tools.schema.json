                        "item"
                      ],
                      "title": "Toward",
                      "type": "string"
                    }
                  },
                  "required": [
                    "toward"
                  ],
                  "title": "FacingTowardInput",
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Facing"
            },
            "itemId": {
              "minLength": 1,
              "title": "Itemid",
              "type": "string"
            },
            "offset": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "dx": {
                      "description": "Translation along world +X in meters.",
                      "title": "Dx",
                      "type": "number"
                    },
                    "dz": {
                      "description": "Translation along world +Z in meters.",
                      "title": "Dz",
                      "type": "number"
                    }
                  },
                  "required": [
