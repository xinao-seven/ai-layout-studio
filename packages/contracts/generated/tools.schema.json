      {
        "description": "Propose removing an item. Pending items may be removed. Needs confirmation.",
        "name": "remove_item",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "itemId": {
              "minLength": 1,
              "title": "Itemid",
              "type": "string"
