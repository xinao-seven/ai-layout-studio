                                  }
                                },
                                "required": [
                                  "type"
                                ],
                                "title": "Anchor",
                                "type": "object"
                              },
                              {
                                "type": "null"
                              }
                            ],
                            "default": null
                          },
                          "clearance": {
                            "anyOf": [
                              {
                                "additionalProperties": false,
                                "properties": {
                                  "back": {
                                    "anyOf": [
                                      {
                                        "minimum": 0,
                                        "type": "number"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ],
                                    "default": null,
                                    "title": "Back"
                                  },
                                  "front": {
                                    "anyOf": [
                                      {
                                        "minimum": 0,
                                        "type": "number"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ],
                                    "default": null,
                                    "title": "Front"
                                  },
                                  "sides": {
                                    "anyOf": [
                                      {
                                        "minimum": 0,
                                        "type": "number"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ],
                                    "default": null,
                                    "title": "Sides"
                                  }
                                },
                                "title": "Clearance",
                                "type": "object"
                              },
                              {
                                "type": "null"
                              }
                            ],
                            "default": null
                          },
                          "facing": {
                            "anyOf": [
                              {
                                "enum": [
                                  "north",
                                  "east",
                                  "south",
                                  "west"
                                ],
                                "title": "FacingDirection",
                                "type": "string"
                              },
                              {
                                "additionalProperties": false,
                                "properties": {
                                  "id": {
                                    "anyOf": [
                                      {
                                        "type": "string"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ],
                                    "default": null,
                                    "title": "Id"
                                  },
                                  "toward": {
                                    "enum": [
                                      "door",
                                      "window",
                                      "item"
                                    ],
                                    "title": "FacingToward",
