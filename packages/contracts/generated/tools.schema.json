                      },
                      "title": "AgainstWallRelation",
                      "type": "object"
                    },
                    {
                      "additionalProperties": false,
                      "description": "Place the item near a window opening.",
                      "properties": {
                        "openingId": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "default": null,
                          "title": "Openingid"
                        },
                        "type": {
